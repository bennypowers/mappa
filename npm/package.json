{
  "name": "@pwrs/mappa",
  "version": "0.0.5",
  "description": "Generate ES module import maps from package.json",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "mappa": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/mappa.d.ts",
      "default": "./dist/mappa.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "postinstall": "[ -f dist/postinstall.js ] && node dist/postinstall.js || true",
    "test": "node --experimental-strip-types --test test/mappa.test.ts"
  },
  "optionalDependencies": {
    "@pwrs/mappa-darwin-arm64": "0.0.5",
    "@pwrs/mappa-darwin-x64": "0.0.5",
    "@pwrs/mappa-linux-arm64": "0.0.5",
    "@pwrs/mappa-linux-x64": "0.0.5",
    "@pwrs/mappa-win32-arm64": "0.0.5",
    "@pwrs/mappa-win32-x64": "0.0.5"
  },
  "files": [
    "dist/mappa.js",
    "dist/mappa.d.ts",
    "dist/cli.js",
    "dist/postinstall.js",
    "dist/mappa.wasm",
    "dist/wasm_exec.js",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bennypowers/mappa.git",
    "directory": "npm"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
